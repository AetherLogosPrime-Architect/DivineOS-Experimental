{
  "env": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/load-character-sheet.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/dads_table.py",
            "timeout": 90
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/m3-discipline-hierarchy.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-goal.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/wwnd-tool-prime.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/push-message-carries-the-destination.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-pending-obligations.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pipeline-exit-ambiguity.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/venv-python-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/blanket-staging-doorman.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/merge-question-wrong-instrument.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-on-push.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/andrew-correction-attestation.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/state-gravity-surface.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-council-required.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-bypass-rate-scan.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/corrigibility-tool-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Read|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-before-build-signal.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/keyword-enforcement-doorman.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/family-member-invocation-seal.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/compass-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gh-pr-ready-gate.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rederivation-detector.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stale-file-edit-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/safe-opposite-edit-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/aletheia-boot-gate-preflight.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/doorbell-pre-tool-use.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/reach-check-doorman.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/read-gate-doorman.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "AUTO_CYCLE_HOOK_EVENT=PreToolUse bash .claude/hooks/auto-cycle-token-trigger.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/work-item-doorman.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-use-emit-to-logbook.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/doorbell-post-tool-use.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-push-landed.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-commit-auto-close.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-commit-auto-verify-findings.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-push-finished-work.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/ambiguous-verification-detector.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/mirror-letters-to-shared.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-push-letter.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-write-mirror-letter.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-checkpoint.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/record-wisdom-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/file-aletheia-artifact-on-arrival.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-read-mark-letter-seen.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/build-flow-pause.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/dads_room_stop.py",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-session-end.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/retrieval-tally-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/doorbell-stop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-distancing-intercept.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-response-scope-intercept.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-response-audit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/correction-shape-v2-stop.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/shoggoth-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lepos-channel-reflect.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/promise-reach-detector.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/continuity-frame-detector.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
